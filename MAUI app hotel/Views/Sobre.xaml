<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI_app_hotel.Views.Sobre"
             Title="Sobre">

    <VerticalStackLayout
        Spacing="15"
        Padding="20"
        VerticalOptions="Center">

        <Label
            Text="Sobre o aplicativo"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="Desenvolvedor: Lucas Fraga Mendes"
            FontSize="18"
            HorizontalOptions="Center" />

        <Label
            Text="Desenvolvido em: 2026"
            FontSize="18"
            HorizontalOptions="Center" />

        <Label
            Text="Aplicativo para cálculo de diárias de hospedagem."
            HorizontalTextAlignment="Center" />

    </VerticalStackLayout>

</ContentPage>
