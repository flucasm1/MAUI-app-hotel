<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI_app_hotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource MidnightBlue}">
    <VerticalStackLayout VerticalOptions="Center">
        <Label
            Text="Suíte Ultra Luxo"
            FontSize="32"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            FontFamily="GermaniaOne"/>

        <Frame Margin="10">
            <HorizontalStackLayout>   
                <HorizontalStackLayout>
                    <Label Text="Adultos: "/>
                    <Label Text="2"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Crianças: "/>
                    <Label Text="1"/>
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </Frame>

        <Frame Margin="10">
            <Grid ColumnDefinitions="*, *, *" 
                  RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Check-In"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Check-Out"/>
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia"/>


                <Label Grid.Row="1" Grid.Column="0" Text="17/12/2026"/>
                <Label Grid.Row="2" Grid.Column="1" Text="03/01/2027"/>
                <Label Grid.Row="3" Grid.Column="2" Text="17 dias"/>

            </Grid>
        </Frame>

        <Frame Margin="10">
            <HorizontalStackLayout>
                <Label Text="Valor Total:"/>
                <Label Text="R$ 1650,00"/>
            </HorizontalStackLayout>
        </Frame>

        <Button Text="Voltar"
                HorizontalOptions="Center"
                Clicked="Voltar_Hospedagem"
                Margin="10"/>
    </VerticalStackLayout>
    
</ContentPage>